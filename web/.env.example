# Read-only REST API base URL. Leave UNSET in production to run "chain-direct"
# (the app reads price/vault/position straight from the Stacks node). For local
# dev with the API stack running, point at it:
VITE_API_URL=http://localhost:4000

# Target Stacks network for wallet writes + contract ids: devnet | testnet | mainnet
VITE_STACKS_NETWORK=devnet

# Deployer principal of the live contracts (from contracts/deployments/
# testnet-deployment.json). REQUIRED for a testnet Vercel build so the bundle
# uses the real contract addresses instead of the placeholder.
# VITE_BACHELIER_DEPLOYER=ST...

# Force-show the mock-token faucet button (auto-on when tokens are the mocks):
# VITE_ENABLE_FAUCET=true
