# ---- shared -----------------------------------------------------------------
STACKS_NETWORK=devnet                 # devnet | testnet | mainnet
STACKS_API_URL=http://localhost:3999  # hiro api (devnet: clarinet devnet)
DATABASE_URL=postgres://bachelier:bachelier@localhost:5432/bachelier

# testnet/mainnet deployments: principal that published the contracts
# BACHELIER_DEPLOYER=ST...
# BACHELIER_SBTC=ST1F7QA2MDF17S807EPA36TSS8AMEFY4KA9TVGWXT.sbtc-token
# BACHELIER_USDC=ST....usdc-token
# BACHELIER_PRICE_FEED=ST....pyth-mock

# ---- indexer ------------------------------------------------------------------
INDEXER_PORT=4001
CHAINHOOK_SECRET=dev-chainhook-secret
START_BLOCK=0
BACKFILL_ON_START=true

# ---- api ----------------------------------------------------------------------
API_PORT=4000
CORS_ORIGIN=http://localhost:5173
RISK_FREE_RATE=0.04
ROUND_LEN_SECS=604800
DEFAULT_IV=0.55
DEFAULT_OTM_BPS=1000

# ---- keeper (separate secret store in production!) ------------------------------
# KEEPER_PRIVATE_KEY=753b7cc01a1a2e86221266a154af739463fce51219d97e4f856cd7200c3bd2a601  # clarinet devnet deployer; never reuse on testnet/mainnet
KEEPER_PORT=4002
OTM_BPS=1000
IV_1E8=55000000
ROUND_CRON=0 8 * * 5
TICK_SECS=60
PRICE_RELAY=true
PRICE_SOURCE_URL=
START_ON_BOOT=true

# ---- web ----------------------------------------------------------------------
VITE_API_URL=http://localhost:4000
VITE_STACKS_NETWORK=devnet
